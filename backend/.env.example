# NeonDB Postgres (leave unset to use a local SQLite file for dev)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# Auth token signing secret
APP_SECRET=change-me-to-a-long-random-string
# SMTP for reminder emails (e.g. Gmail app password, or Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
# Tavily for Latest Info
TAVILY_API_KEY=tvly-...
# Groq LLM for the AI assistant (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_...
